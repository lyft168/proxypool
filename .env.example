# proxypool configuration — copy to .env and adjust.
# Only EMAIL_DOMAIN is strictly required; POOL_FILE defaults to
# "<repo>/proxies_http.txt" (next to main.py) if left unset.

# Working directory for all inputs/outputs. Leave unset to use the directory
# that contains main.py — recommended; override only if you want outputs
# elsewhere. Must be an absolute path.
#BASE_DIR=

# Upstream proxy pool: one HTTP proxy per line, host:port:user:pass. Used
# round-robin as the outbound connection for each registration attempt.
# Leave unset to use "<BASE_DIR or repo>/proxies_http.txt". Use an absolute
# path (e.g. $PWD/proxies_http.txt) — "~" and relative paths are not expanded.
#POOL_FILE=

# Domain used for generated registration email addresses (required).
EMAIL_DOMAIN=example.com

# How many accounts to register per scheduled run.
#ACCOUNTS_PER_RUN=1

# Retries per account before giving up.
#MAX_ATTEMPTS=4

# X display for the browser (run.sh starts Xvfb on it if missing).
#DISPLAY=:99

# pxserve.py bind address and port.
#SERVE_HOST=0.0.0.0
#SERVE_PORT=8126

# Country lookup endpoint; response must contain "countryCode":"XX".
#GEO_API_URL=http://ip-api.com/json/?fields=countryCode
